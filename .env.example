# All optional. Defaults live in echo_os/settings.py.

# HTTP port for the hook endpoint and panel. Reinstall (./echoctl install) after changing it.
# ECHO_OS_PORT=8431
# ECHO_OS_LAUNCHD_LABEL=local.echo-os

# Long-horizon gate: echo only turns at least this long AND with at least this many tool calls.
# ECHO_OS_MIN_TURN_SECONDS=180
# ECHO_OS_MIN_TOOL_CALLS=5

# Set to false to skip the KB relevance agent (notes-kb).
# ECHO_OS_KB_AGENT=true

# Voice: macos-say (default, no setup) or openai (needs OPENAI_API_KEY).
# ECHO_OS_VOICE=macos-say
# ECHO_OS_SAY_VOICE=Samantha
# ECHO_OS_SAY_RATE=190
# OPENAI_API_KEY=
# ECHO_OS_OPENAI_TTS_VOICE=alloy
